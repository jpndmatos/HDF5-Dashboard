{
  "name": "hdf5-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:api": "python -m venv .venv && .venv\\Scripts\\python -m pip install -r api/requirements.txt",
    "start:api": ".venv\\Scripts\\python -m flask --app api.main run --port 5008",
    "start:frontend": "vite",
    "start": "concurrently \"npm run start:api\" \"npm run start:frontend\"",
    "build": "vite build",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "plotly.js-dist": "^2.33.0"
  },
  "main": "index.js",
